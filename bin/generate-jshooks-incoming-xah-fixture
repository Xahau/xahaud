#!/usr/bin/env python3
"""Embed the audited packaged incoming-XAH Hook for JSHooks_test."""

from __future__ import annotations

import argparse
import hashlib
from pathlib import Path


EXPECTED_SOURCE_SHA256 = (
    "3f26a6a4425764c6aca8e885ec59e1e19a12ef2d5907f617ef6041481e0f8125"
)
EXPECTED_ARTIFACT_SHA256 = (
    "3ffe748d46ee9db7e7614d6ba070a09d289e858ca53bbe64643b5881e11771c4"
)
EXPECTED_BYTECODE_SHA256 = (
    "6c200327eddd6da30066089bf1cb8fa71746b8186e37335e853f6f16e69e2bd6"
)
EXPECTED_PROVIDER_SHA256 = (
    "a88e532d39ffc77434200201ebabda1b1a11d602b1ca82aadcfdef729417005a"
)
QUICKJS_HEADER_SIZE = 80


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def require_identity(label: str, data: bytes, expected: str) -> None:
    actual = sha256(data)
    if actual != expected:
        raise RuntimeError(f"{label} SHA-256 {actual}, expected {expected}")


def render(artifact: bytes) -> str:
    rows = []
    for offset in range(0, len(artifact), 12):
        chunk = artifact[offset : offset + 12]
        rows.append("    " + ", ".join(f"0x{value:02x}U" for value in chunk) + ",")
    return f"""// Generated by bin/generate-jshooks-incoming-xah-fixture; do not edit.
// Source SHA-256:
//   {EXPECTED_SOURCE_SHA256}
// Provider SHA-256:
//   {EXPECTED_PROVIDER_SHA256}
// Bytecode SHA-256:
//   {EXPECTED_BYTECODE_SHA256}
// Artifact SHA-256:
//   {EXPECTED_ARTIFACT_SHA256}
#ifndef JSHOOKS_INCOMING_XAH_TEST_HOOK_INCLUDED
#define JSHOOKS_INCOMING_XAH_TEST_HOOK_INCLUDED
#include <array>
#include <cstdint>

namespace ripple::test {{

inline constexpr char jshooksIncomingXahSourceSHA256[] =
    "{EXPECTED_SOURCE_SHA256}";
inline constexpr char jshooksIncomingXahProviderSHA256[] =
    "{EXPECTED_PROVIDER_SHA256}";
inline constexpr char jshooksIncomingXahBytecodeSHA256[] =
    "{EXPECTED_BYTECODE_SHA256}";
inline constexpr char jshooksIncomingXahArtifactSHA256[] =
    "{EXPECTED_ARTIFACT_SHA256}";
inline constexpr std::array<std::uint8_t, {len(artifact)}>
    jshooksIncomingXahArtifact = {{{{
{chr(10).join(rows)}
}}}};

}}  // namespace ripple::test

#endif
"""


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--source", required=True, type=Path)
    parser.add_argument("--artifact", required=True, type=Path)
    parser.add_argument("--bytecode", required=True, type=Path)
    parser.add_argument("--wasm", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()

    source = args.source.read_bytes()
    artifact = args.artifact.read_bytes()
    bytecode = args.bytecode.read_bytes()
    provider = args.wasm.read_bytes()
    require_identity("source", source, EXPECTED_SOURCE_SHA256)
    require_identity("artifact", artifact, EXPECTED_ARTIFACT_SHA256)
    require_identity("bytecode", bytecode, EXPECTED_BYTECODE_SHA256)
    require_identity("provider", provider, EXPECTED_PROVIDER_SHA256)
    if len(artifact) != QUICKJS_HEADER_SIZE + len(bytecode):
        raise RuntimeError(
            "packaged artifact length does not match its bytecode payload"
        )
    if artifact[QUICKJS_HEADER_SIZE:] != bytecode:
        raise RuntimeError("packaged artifact does not contain the audited bytecode")

    args.output.write_text(render(artifact))
    print(f"wrote {args.output}: {len(artifact)} bytes, sha256 {sha256(artifact)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
