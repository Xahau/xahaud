#!/usr/bin/env python3
"""Generate the unchecked QuickJS bytecode fixture used by JSHooks_test."""

from __future__ import annotations

import argparse
import hashlib
from pathlib import Path

from jshookz.host import WasmHost
from jshookz.xfl_profile import XFLArithmeticProfile


def compile_once(source: str, wasm: Path) -> bytes:
    host = WasmHost(wasm_path=wasm)
    host.init()
    try:
        bytecode = host.compile_source(source, module=True)
        validation = host.validate_hook_bytecode(bytecode)
    finally:
        host.destroy()
    if not validation.valid:
        raise RuntimeError(
            "unchecked fixture failed provider validation: "
            f"{validation.error or 'unknown error'}"
        )
    if validation.profile is not XFLArithmeticProfile.NEAREST_EVEN_V1:
        raise RuntimeError(
            "unchecked fixture selected profile "
            f"{validation.profile.value}, expected nearestEvenV1"
        )
    return bytecode


def render(source: Path, wasm: Path, bytecode: bytes) -> str:
    source_sha = hashlib.sha256(source.read_bytes()).hexdigest()
    provider_sha = hashlib.sha256(wasm.read_bytes()).hexdigest()
    bytecode_sha = hashlib.sha256(bytecode).hexdigest()
    rows = []
    for offset in range(0, len(bytecode), 12):
        chunk = bytecode[offset : offset + 12]
        rows.append("    " + ", ".join(f"0x{value:02x}U" for value in chunk) + ",")
    return f"""// Generated by bin/generate-jshooks-bypass-fixture; do not edit.
// Source SHA-256: {source_sha}
// Provider SHA-256: {provider_sha}
// Bytecode SHA-256: {bytecode_sha}
#ifndef JSHOOKS_BYPASS_TEST_HOOK_INCLUDED
#define JSHOOKS_BYPASS_TEST_HOOK_INCLUDED
#include <array>
#include <cstdint>

namespace ripple::test {{

inline constexpr char jshooksBypassSourceSHA256[] = "{source_sha}";
inline constexpr char jshooksBypassProviderSHA256[] = "{provider_sha}";
inline constexpr char jshooksBypassBytecodeSHA256[] = "{bytecode_sha}";
inline constexpr std::array<std::uint8_t, {len(bytecode)}>
    jshooksNearestEvenBypassBytecode = {{{{
{chr(10).join(rows)}
}}}};

}}  // namespace ripple::test

#endif
"""


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--source", required=True, type=Path)
    parser.add_argument("--wasm", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()

    source = args.source.resolve()
    wasm = args.wasm.resolve()
    first = compile_once(source.read_text(), wasm)
    second = compile_once(source.read_text(), wasm)
    if first != second:
        raise RuntimeError("unchecked fixture compilation is not deterministic")
    args.output.write_text(render(source, wasm, first))
    print(
        f"wrote {args.output}: {len(first)} bytes, "
        f"sha256 {hashlib.sha256(first).hexdigest()}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
