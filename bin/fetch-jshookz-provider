#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
bundle="${root}/external/quickjs-provider"
lock="${bundle}/jshookz_provider.lock.json"
provider="${bundle}/jshookz_provider.wasm"

provider_sha=$(python3 -c \
  'import json,sys; print(json.load(open(sys.argv[1]))["provider"]["sha256"])' \
  "${lock}")
provider_size=$(python3 -c \
  'import json,sys; print(json.load(open(sys.argv[1]))["provider"]["size"])' \
  "${lock}")
provider_url="${XAHAU_QJS_PROVIDER_URL:-https://github.com/sublimator/jshookz/releases/download/provider-${provider_sha}/jshookz_provider.wasm}"

verify_provider()
{
  python3 - "$1" "${provider_sha}" "${provider_size}" <<'PY'
import hashlib
from pathlib import Path
import sys

provider = Path(sys.argv[1]).read_bytes()
expected_sha = sys.argv[2]
expected_size = int(sys.argv[3])
actual_sha = hashlib.sha256(provider).hexdigest()
if actual_sha != expected_sha or len(provider) != expected_size:
    raise SystemExit(
        f"provider lock mismatch: sha256={actual_sha} size={len(provider)}"
    )
PY
}

if [[ -f "${provider}" ]] && verify_provider "${provider}"; then
  echo "Using locked JSHookz provider: ${provider}"
  exit 0
fi

temporary_provider="${provider}.tmp"
trap 'rm -f "${temporary_provider}"' EXIT
curl --fail --location --retry 3 --proto '=https' --tlsv1.2 \
  "${provider_url}" --output "${temporary_provider}"
verify_provider "${temporary_provider}"
mv "${temporary_provider}" "${provider}"
trap - EXIT
